<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer: keep the reminders prefs (Jellyfin token) out -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="jellytip-reminders.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="jellytip-reminders.xml" />
    </device-transfer>
</data-extraction-rules>
